{
  "crons": [
    { "path": "/api/cron/snapshots", "schedule": "0 * * * *" },
    { "path": "/api/cron/random-picks", "schedule": "5 * * * *" },
    { "path": "/api/cron/hidden-gems", "schedule": "0 6 * * *" }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.kingof.lol" }],
      "destination": "https://kingof.lol/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
