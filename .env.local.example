# Local development credentials
# Copy this file to .env.local and fill in your sandbox values

# Postgres — local or Vercel Postgres connection string
DATABASE_URL=postgresql://localhost:5432/kingof

# Stripe TEST mode keys — get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Site URL — leave as localhost for dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend TEST mode — get from https://resend.com/api-keys
# Use "re_test_..." key so emails go to Resend's test inbox
RESEND_API_KEY=re_test_REPLACE_ME

# Security salt for IP hashing — any random string
IP_HASH_SALT=local-dev-salt-not-for-production

# Cron job secret — any random string
CRON_SECRET=local-dev-cron-secret

# Search engine verification (optional, not needed locally)
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
