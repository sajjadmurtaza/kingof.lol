{
  "name": "kingof",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "dev:fresh": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env.local --tsconfig tsconfig.scripts.json src/db/seed.ts",
    "db:setup": "npm run db:push && npm run db:seed",
    "db:studio": "drizzle-kit studio",
    "validate:i18n": "tsx --tsconfig tsconfig.scripts.json scripts/validate-i18n.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run validate:i18n && npm run build"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.70.0",
    "@vercel/analytics": "^2.0.1",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.2",
    "next-intl": "^4.13.7",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.22.0",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.0",
    "@netlify/plugin-nextjs": "^5.15.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.0",
    "eslint-config-next": "^16.3.2",
    "happy-dom": "^20.11.6",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
